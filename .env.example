# ==============================================================================
# EVENTIFY ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# Database (PostgreSQL - Neon / Local)
# ------------------------------------------------------------------------------
# Direct connection for migrations, pooled connection for serverless endpoints
DATABASE_URL=postgresql://akshat@localhost:5432/eventify_dev
DIRECT_URL=postgresql://akshat@localhost:5432/eventify_dev
# Example for Neon in production:
# DATABASE_URL=postgresql://[user]:[password]@[endpoint]-pooler.neon.tech/neondb?sslmode=require&pgbouncer=true
# DIRECT_URL=postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# Authentication (JWT & Cookies)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_random_string_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_random_string_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_encryption_secret_key_here

# ------------------------------------------------------------------------------
# Upstash Redis (Caching & Rate Limiting)
# ------------------------------------------------------------------------------
# In local development without Upstash, Eventify gracefully uses resilient in-memory caching and rate limiting
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (TEST MODE)
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# Cloudinary Image Storage
# ------------------------------------------------------------------------------
# Obtain from Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# Resend Transactional Email
# ------------------------------------------------------------------------------
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Eventify <notifications@resend.dev>

# ------------------------------------------------------------------------------
# Cron Automation Secret
# ------------------------------------------------------------------------------
# Secret token for authenticating Vercel Cron jobs or external schedulers
CRON_SECRET=your_secure_cron_execution_secret_token_here

# ------------------------------------------------------------------------------
# Platform Configuration Defaults
# ------------------------------------------------------------------------------
PLATFORM_CURRENCY=INR
PLATFORM_TIMEZONE=Asia/Kolkata
TICKET_RESERVATION_TIMEOUT_MINUTES=10
